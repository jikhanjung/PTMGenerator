#: core.serial_controller:1 of
msgid "Talking to the Arduino LED-dome controller."
msgstr ""

#: core.serial_controller:3 of
msgid ""
"The firmware reads messages framed with angle brackets and split on "
"commas — `<ON,7>`, `<SHOOT,7>`, `<OFF>` — at 9600 baud, and echoes human-"
"readable status lines back that nothing parses."
msgstr ""

#: core.serial_controller:7 of
msgid ""
"Every method tolerates there being no port. A capture can legitimately be"
" started with no controller attached (the user is asked first, and may "
"say to go ahead), and before this was centralised here each call site "
"reached for a `serial` attribute that openSerial had never assigned."
msgstr ""

#: core.serial_controller.SerialController:1 of
msgid "The controller's serial port, or the absence of one."
msgstr ""

#: core.serial_controller.SerialController.last_error:1 of
msgid ""
"Why the last open() failed, or None. Set when a port is configured but "
"could not be opened, which the UI reports differently from there being no"
" port at all."
msgstr ""

#: core.serial_controller.SerialController.is_configured:1 of
msgid "True when a port name is set, whether or not it can be opened."
msgstr ""

#: core.serial_controller.SerialController.open:1 of
msgid "Open the configured port. Returns True if there is one to talk to."
msgstr ""

#: core.serial_controller.SerialController.open:3 of
msgid ""
"Never raises. The port name is stored in preferences, so the application "
"will eventually try one that has gone away — the board unplugged, the "
"Arduino IDE's serial monitor holding it, a USB port re-enumerated to a "
"different number, or the preferences carried to another machine. That "
"used to let a SerialException escape into a Qt slot, which aborts the "
"process with no message."
msgstr ""

#: core.serial_controller.SerialController.close:1 of
msgid "Turn the LEDs off and release the port. Safe when never opened."
msgstr ""

#: core.serial_controller.SerialController.send:1 of
msgid "Frame and write a message. Discarded, with a note, if there is no port."
msgstr ""

#: core.serial_controller.SerialController.receive:1 of
msgid "Read one echoed status line, or None if there is no port."
msgstr ""

#: core.serial_controller.SerialController.turn_on:1 of
msgid "Light LED `led_index` (0-based here, 1-based on the wire)."
msgstr ""

#: core.serial_controller.SerialController.shoot:1 of
msgid "Light LED `led_index` and fire the shutter."
msgstr ""

#: core.serial_controller.SerialController.available_ports:1 of
msgid "Device names of the serial ports currently present."
msgstr ""

#: core.light_positions:1 of
msgid "The dome's LED geometry."
msgstr ""

#: core.light_positions:3 of
msgid ""
"PTMfitter wants a unit vector per shot, pointing from the specimen "
"towards the light that was on. The dome is described in polar coordinates"
" instead — one [elevation, azimuth] pair per LED, in degrees — so this "
"module is the conversion between the two."
msgstr ""

#: core.light_positions.light_vectors:1 of
msgid "Convert the polar LED table into unit vectors for the .lp file."
msgstr ""

#: core.light_positions.light_vectors:3 of
msgid ""
"Degrees to rotate the whole dome about the vertical axis, to line LED #1 "
"up with how the specimen is sitting. Elevation is unaffected."
msgstr ""

#: core.light_positions.light_vectors:8 of
msgid "One [x, y, z] unit vector per LED, in LED order."
msgstr ""

#: core.image_data:1 of
msgid "The capture table: one slot per LED, and how it is persisted."
msgstr ""

#: core.image_data:3 of
msgid ""
"A run produces one image per LED. The table that tracks them is a list of"
" `CaptureSlot`s, mirrored to `image_data.csv` in the capture directory so"
" a run can be reopened later."
msgstr ""

#: core.image_data:7 of
msgid ""
"Slots for shots that failed carry \"-\" for both the directory and the "
"filename, which keeps the LED index aligned with the light-position table"
" even when part of a run is missing."
msgstr ""

#: core.image_data.CaptureSlot:1 of
msgid "One LED's shot. A plain tuple, so existing unpacking keeps working."
msgstr ""

#: core.image_data.CaptureSlot.directory:1 of
msgid "Alias for field number 1"
msgstr ""

#: core.image_data.CaptureSlot.filename:1 of
msgid "Alias for field number 2"
msgstr ""

#: core.image_data.CaptureSlot.include:1 of
msgid "Alias for field number 3"
msgstr ""

#: core.image_data.CaptureSlot.captured:1 of
msgid "False for a shot that never arrived."
msgstr ""

#: core.image_data.CSV_ENCODINGS:1 of
msgid ""
"that is what write_csv produces, and -sig absorbs the byte-order mark a "
"spreadsheet adds when someone opens the file to look at it. The fallbacks"
" are for tables written before this was pinned, when the encoding was "
"whatever the machine defaulted to -- cp949 on Korean Windows. latin-1 "
"decodes any byte sequence, so the last attempt always succeeds: a legacy "
"name may come back mangled, but the run still opens, which beats refusing"
" to load it at all."
msgstr ""

#: core.image_data.CSV_ENCODINGS:9 of
msgid "Tried in order when reading a capture table. utf-8-sig first"
msgstr ""

#: core.image_data.read_csv:1 of
msgid "Load a capture table. Returns [] if there is no file."
msgstr ""

#: core.image_data.read_csv:3 of
msgid ""
"Accepts the 3-column format written before include flags existed; those "
"rows default to included."
msgstr ""

#: core.image_data.write_csv:1 of
msgid "Write the capture table, overwriting whatever was there."
msgstr ""

#: core.image_data.write_csv:3 of
msgid ""
"utf-8 explicitly, not the platform default. The table holds directory and"
" file names, which for this application are routinely non-ASCII, and it "
"is written into the capture directory to be read back later — possibly on"
" a machine whose default encoding is cp949 rather than utf-8."
msgstr ""

#: core.image_data.detect_irregular_intervals:1 of
msgid "Rebuild the capture table for a directory of already-taken images."
msgstr ""

#: core.image_data.detect_irregular_intervals:3 of
msgid ""
"Sorts the images by creation time, takes the most frequent gap between "
"consecutive files as the typical shot interval, and reads any gap longer "
"than 1.5x that as one or more missed shots, inserting a placeholder slot "
"for each so the surviving images keep their original LED indices."
msgstr ""

#: core.image_data.detect_irregular_intervals:8 of
msgid "Directory to scan. Not searched recursively."
msgstr ""

#: core.image_data.detect_irregular_intervals:10 of
msgid "Seam for tests, which need exact intervals without sleeping."
msgstr ""

#: core.image_data.detect_irregular_intervals:12 of
msgid ""
"One slot per LED position. Empty when fewer than two images make the "
"interval unmeasurable."
msgstr ""

#: core.image_data.find_newest_image:1 of
msgid "The most recent image under `directory` modified after `newer_than`."
msgstr ""

#: core.image_data.find_newest_image:3 of
msgid "Where to look."
msgstr ""

#: core.image_data.find_newest_image:5 of
msgid "Only files strictly newer than this are considered."
msgstr ""

#: core.image_data.find_newest_image:7 of
msgid ""
"Search subdirectories too. Needed while waiting for the first shot of a "
"run, because tethering software — Canon's EOS Utility among others — "
"files images into a dated subfolder that does not exist until that first "
"shot lands. Once a shot has arrived the caller knows which directory to "
"watch and can stop walking the tree, which matters at one poll per "
"second."
msgstr ""

#: core.image_data.find_newest_image:15 of
msgid "(path, mtime), or (None, newer_than) if nothing new has landed."
msgstr ""

#: core.ptm_builder:1 of
msgid "Producing a .ptm, either in-process or by driving PTMfitter.exe."
msgstr ""

#: core.ptm_builder:3 of
msgid ""
"`generate_native` is the default and does the fit here — see "
"`core.ptm_fitter`. `generate` shells out to the external `PTMfitter.exe`,"
" which is kept selectable while the native path proves itself on real "
"captures, and which is why the rest of this module exists at all."
msgstr ""

#: core.ptm_builder:8 of
msgid ""
"PTMfitter is a Hewlett-Packard binary from around 2001 and it is "
"particular about paths. Measured against the shipped `PTMfitter.exe` with"
" nine images:"
msgstr ""

#: core.ptm_builder:12 of
msgid ".lp lists bare filenames, run with cwd = the image directory"
msgstr ""

#: core.ptm_builder:12 core.ptm_builder:13 core.ptm_builder:14
#: core.ptm_builder:15 core.ptm_builder:16 core.ptm_builder:21
#: core.ptm_builder:23 of
msgid "works"
msgstr ""

#: core.ptm_builder:13 of
msgid "... directory name contains a space"
msgstr ""

#: core.ptm_builder:14 of
msgid "... directory name contains Hangul"
msgstr ""

#: core.ptm_builder:15 of
msgid "... directory path is very long"
msgstr ""

#: core.ptm_builder:16 of
msgid ".lp lists absolute paths, ASCII, no spaces"
msgstr ""

#: core.ptm_builder:17 of
msgid ".lp lists absolute paths containing a space"
msgstr ""

#: core.ptm_builder:17 core.ptm_builder:18 core.ptm_builder:19
#: core.ptm_builder:20 core.ptm_builder:22 of
msgid "FAILS"
msgstr ""

#: core.ptm_builder:18 of
msgid ".lp lists absolute paths containing Hangul"
msgstr ""

#: core.ptm_builder:19 of
msgid "a filename inside the .lp contains a space"
msgstr ""

#: core.ptm_builder:20 of
msgid "-o is an absolute path containing a space and Hangul"
msgstr ""

#: core.ptm_builder:21 of
msgid "-o is a relative ASCII name"
msgstr ""

#: core.ptm_builder:22 of
msgid "a Hangul filename, .lp written as UTF-8"
msgstr ""

#: core.ptm_builder:23 of
msgid "a Hangul filename, .lp written as CP949"
msgstr ""

#: core.ptm_builder:26 of
msgid "Two separate constraints come out of that:"
msgstr ""

#: core.ptm_builder:28 of
msgid ""
"**It splits each .lp line on whitespace**, so anything containing a space"
" is read as part of the light vector. No amount of encoding fixes this."
msgstr ""

#: core.ptm_builder:30 of
msgid ""
"**It reads the .lp in the machine's ANSI codepage**, not UTF-8 — which is"
" what a 2001 Windows binary using `fopen` would do. So a Hangul filename "
"works when the file is written as CP949 on a Korean Windows, and fails as"
" UTF-8."
msgstr ""

#: core.ptm_builder:34 of
msgid ""
"Where the process happens to be running does not matter at all; only what"
" it parses does. So the .lp lists bare filenames, is written in the local"
" ANSI codepage, the output name handed to it is relative ASCII, and cwd "
"is set to the images. Python then moves the result wherever the user "
"asked, having no such difficulty. A filename it could not read either way"
" — one containing a space — is worked around by staging the images under "
"safe names."
msgstr ""

#: core.ptm_builder:41 of
msgid ""
"In practice neither arises: the images come straight off the camera as "
"IMG_9999.JPG. This is here so that a renamed file produces a working fit "
"or a clear error, rather than a silently wrong one."
msgstr ""

#: core.ptm_builder:45 of
msgid ""
"Note also that **the fitter returns 1 on success**, so its exit status "
"cannot be used to tell whether it worked; the output file is checked "
"instead."
msgstr ""

#: core.ptm_builder.UNSAFE_FILENAME:1 of
msgid ""
"The fitter tokenises .lp lines on whitespace, so a name containing any is"
" unusable whatever the encoding."
msgstr ""

#: core.ptm_builder.STAGED_LP:1 of
msgid "Names used while the fitter runs, before the result is moved into place."
msgstr ""

#: core.ptm_builder.PtmFitterNotFoundError:1 of
msgid "The configured PTMfitter executable is not on disk."
msgstr ""

#: core.ptm_builder.PtmFitterFailedError:1 of
msgid "PTMfitter ran but produced no output."
msgstr ""

#: core.ptm_builder.PtmFitterFailedError:3 of
msgid ""
"The message names what was run and where to look, which is what the user "
"has to act on -- the fitter itself reports almost nothing."
msgstr ""

#: core.ptm_builder.NoImagesToFitError:1 of
msgid "Every slot is missing or unchecked."
msgstr ""

#: core.ptm_builder.lp_encoding:1 of
msgid "The encoding PTMfitter reads a .lp in: the machine's ANSI codepage."
msgstr ""

#: core.ptm_builder.lp_encoding:3 of
msgid ""
"`mbcs` is that codepage on Windows, which is where the fitter runs. Off "
"Windows there is no such thing, so the platform's preferred encoding "
"stands in — only the test suite exercises that path."
msgstr ""

#: core.ptm_builder.is_safe_filename:1 of
msgid "True if PTMfitter can read this name out of a .lp file."
msgstr ""

#: core.ptm_builder.is_safe_filename:3 of
msgid ""
"Two ways it cannot: whitespace, which its parser splits on, and a "
"character absent from the codepage it reads the file in."
msgstr ""

#: core.ptm_builder.usable_slots:1 of
msgid "The slots that belong in a .lp: captured, and included by the user."
msgstr ""

#: core.ptm_builder.normalise_extension:1 of
msgid "Lowercase the extension."
msgstr ""

#: core.ptm_builder.normalise_extension:3 of
msgid ""
"Tethering software writes .JPG as often as .jpg and the fitter is case-"
"sensitive about what it is given."
msgstr ""

#: core.ptm_builder.build_lp_content:1 of
msgid "Render the .lp file."
msgstr ""

#: core.ptm_builder.build_lp_content:3 of
msgid ""
"The capture table. Shots that failed and shots the user unchecked are "
"left out of both the count and the body."
msgstr ""

#: core.ptm_builder.build_lp_content:6 core.ptm_builder.generate:5
#: core.ptm_builder.generate_native:10 of
msgid "Unit vectors, indexed by LED."
msgstr ""

#: core.ptm_builder.build_lp_content:8 of
msgid ""
"One filename per usable slot, when the images have been staged under "
"different names. Defaults to each slot's own."
msgstr ""

#: core.ptm_builder.build_lp_content:12 of
msgid ""
"The complete file contents. Filenames only, never paths -- see the module"
" docstring for why."
msgstr ""

#: core.ptm_builder.lp_path_for:1 of
msgid "Where the kept .lp goes: beside the images, named after their directory."
msgstr ""

#: core.ptm_builder.write_lp:1 of
msgid "Write a .lp for the fitter, in the codepage it reads."
msgstr ""

#: core.ptm_builder.write_lp:3 of
msgid ""
"Strict on purpose: if this raises, the staging check has a hole in it. "
"Failing loudly beats writing a file the fitter silently misreads."
msgstr ""

#: core.ptm_builder.write_reference_lp:1 of
msgid "Write the .lp kept beside the images, for a human to look at."
msgstr ""

#: core.ptm_builder.write_reference_lp:3 of
msgid ""
"This one records the real filenames, which may be non-ASCII, so it is "
"written as utf-8 and is not what the fitter is given."
msgstr ""

#: core.ptm_builder.generate:1 of
msgid "Build the .lp, run PTMfitter, and put the .ptm where it was asked for."
msgstr ""

#: core.ptm_builder.generate:3 core.ptm_builder.generate_native:8 of
msgid "The capture table."
msgstr ""

#: core.ptm_builder.generate:7 of
msgid "The PTMfitter executable."
msgstr ""

#: core.ptm_builder.generate:9 of
msgid ""
"Where the finished .ptm should end up. May contain anything -- spaces, "
"Hangul -- because Python moves it there."
msgstr ""

#: core.ptm_builder.generate:12 of
msgid "Seam for tests. Called as runner(command, cwd=...)."
msgstr ""

#: core.ptm_builder.generate:14 of
msgid ""
"The .lp written beside the images, kept for inspection when a fit looks "
"wrong."
msgstr ""

