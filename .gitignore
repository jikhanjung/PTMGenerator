# Build output
dist/
build/
# Artifacts downloaded from CI with `gh run download`
dist-ci/

# Runtime output
image_data.csv
*.log

# Python
__pycache__/
*.pyc

# Tooling
.claude/settings.local.json

# Note: PTMGenerator2.spec is build configuration (source), so it is tracked.
# Written by the spec at build time and read back by core/build_info.py. Not
# tracked: a committed one would be whatever the last local build stamped, and
# the About dialog would then report a stale build number as if it were real.
build_info.json

# Coverage
.coverage
coverage.xml
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Sphinx
docs/manual/_build/

# Generated from installer/*.iss.template by CI, and by anyone building locally.
installer/*.iss
installer/Output/

# Symlink to the shared PaleoBytes guide set (a checkout of the private devdocs
# repo). Referenced, never copied — a copy drifts from the source. See devlog 016.
.guides
