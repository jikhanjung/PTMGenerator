# Normalize line endings: store LF in the repository, check out native.
# Added because the working tree drifted to CRLF (WSL/Windows mix), which made
# every file show as fully modified in `git diff` with zero real changes.
* text=auto

# Explicit text types
*.py    text diff=python
*.ino   text
*.txt   text
*.csv   text
*.md    text
*.ts    text
*.spec  text

# Binary — never touch these
*.exe   binary
*.png   binary
*.ico   binary
*.qm    binary
*.pyc   binary

# CRLF, because Windows shells need it. Nothing here uses them yet; the rule
# is cheap now and is the sort of thing nobody thinks of when adding the first
# one.
*.bat   text eol=crlf
*.cmd   text eol=crlf
